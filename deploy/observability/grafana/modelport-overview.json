          "expr": "modelport_ledger_operation_degraded",
          "format": "table",
          "instant": true,
          "legendFormat": "{{operation}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "账本操作状态",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true
            },
            "indexByName": {},
            "renameByName": {
              "Value": "状态",
              "instance": "实例",
              "operation": "操作"
            }
          }
        }
      ],
      "type": "table"
    },
