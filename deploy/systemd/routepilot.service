[Unit]
Description=RoutePilot local Claude model gateway
Documentation=https://github.com/lizzjin/RoutePilot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/routepilot/routepilot.env
Environment=RUST_LOG=routepilot=info,tower_http=info
Environment=ROUTEPILOT_STATE_DIR=/var/lib/routepilot
ExecStart=/usr/local/bin/routepilot
WorkingDirectory=/var/lib/routepilot
Restart=always
RestartSec=3

DynamicUser=true
StateDirectory=routepilot
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
